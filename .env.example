APP_ENVIRONMENT=development
API_PORT=8000
FRONTEND_PORT=3000
VBE_API_INTERNAL_URL=http://api:8000
DEPENDENCY_TIMEOUT_SECONDS=2
REVIEW_ACTOR_ID=synthetic-analyst

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_INPUT_CHARS=12000
GEMINI_MAX_OUTPUT_TOKENS=2048

# Provedor alternativo e opcional para extracao da ficha tecnica.
# A chave permanece vazia no arquivo versionado e deve existir apenas no .env local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_ATTEMPTS=3
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_INPUT_USD_PER_MILLION=0.10
OPENAI_OUTPUT_USD_PER_MILLION=0.50

N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_a_random_local_demo_value

POSTGRES_DB=vbehub
POSTGRES_ADMIN_USER=vbehub_admin
POSTGRES_ADMIN_PASSWORD=replace_for_local_use
POSTGRES_APP_USER=vbehub_app
POSTGRES_APP_PASSWORD=replace_for_local_use
